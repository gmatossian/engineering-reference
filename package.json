{
  "name": "engineering-reference",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "ng": "ng",
    "content:generate": "node tools/content/generate.ts",
    "prestart": "npm run content:generate",
    "start": "ng serve",
    "prebuild": "npm run content:generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app && npm run test:tools",
    "pretest:app": "npm run content:generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "preserve:e2e:fixture": "ENGINEERING_REFERENCE_CONTENT_ROOT=e2e/fixtures/content npm run content:generate",
    "serve:e2e:fixture": "ng serve --host 127.0.0.1 --port 4173",
    "serve:e2e:catalog": "serve -s dist/engineering-reference-real/browser -l 4174 --no-port-switching",
    "test:e2e": "npm run build && node tools/e2e/run.ts",
    "test:app": "ng test --watch=false",
    "test:tools": "vitest run --config vitest.node.config.ts",
    "check": "npm run content:generate && npm run format:check && npm run lint && npm run typecheck:tools && npm test && npm run test:e2e",
    "typecheck:tools": "tsc --project tsconfig.tools.json"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.0.8",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
